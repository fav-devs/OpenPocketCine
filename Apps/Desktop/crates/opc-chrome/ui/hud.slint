// OpenPocketCine viewfinder chrome — DJI Mimo layout.
//
// Layout (landscape desktop):
//
//  ┌── TopBar (48px) ─────────────────────────────── ●LINK   REC ●──┐
//  ├── ZoomStrip (44px) ──── 1× ━━━●──────── 6× ──────────────────┤
//  │                                                                  │
//  │  chip1 │                                         │  signal      │
//  │  chip2 │        V I D E O   F R A M E            │  battery     │
//  │  chip3 │                                         │  storage     │
//  │  chip4 │                                         │  timer       │
//  │                                                                  │
//  ├── BottomBar (80px) ──[Gimbal]──────[REC]──────[STILL FLIP CTR]─┤
//  └──────────────────────────────────────────────────────────────────┘

// ── Colour palette ────────────────────────────────────────────────────────────

global Pal {
    out property <color> online:       #34c759;
    out property <color> offline:      #8e8e93;
    out property <color> rec:          #ff3b30;
    out property <color> rec-bg:       #ff3b3030;
    out property <color> warn:         #ffd60a;
    out property <color> chip-text:    #ffffffe6;
    out property <color> chip-dim:     #ffffffb0;
    out property <color> panel-bg:     #000000d9;
    out property <color> panel-border: #ffffff1a;
    out property <color> panel-shine:  #ffffff12;
    out property <color> bar-bg:       #000000cc;
    out property <color> ctrl-border:  #ffffff50;
}

// ── ZoomSlider primitive ──────────────────────────────────────────────────────

component ZoomSlider {
    in-out property <float> value: 1.0;
    in property <float> minimum: 1.0;
    in property <float> maximum: 6.0;
    callback changed(float);

    height: 32px;
    min-width: 120px;

    property <float> pct: (root.value - root.minimum) / (root.maximum - root.minimum);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 3px;
        background: #ffffff30;
        border-radius: 2px;
        Rectangle {
            width: root.pct * parent.width;
            height: 3px;
            background: white;
            border-radius: 2px;
        }
    }

    Rectangle {
        width: 16px; height: 16px;
        border-radius: 8px;
        x: root.pct * (root.width - self.width);
        y: (parent.height - self.height) / 2;
        background: white;
    }

    ta := TouchArea {
        moved => {
            if self.pressed {
                let p = (self.mouse-x / root.width).clamp(0, 1);
                root.value = root.minimum + p * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                let p = (self.mouse-x / root.width).clamp(0, 1);
                root.value = root.minimum + p * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
    }
}

// ── Top bar — connection left, REC badge right ────────────────────────────────

component TopBar {
    in property <string> link-state;
    in property <bool>   is-recording;
    in property <string> rec-elapsed;

    height: 48px;

    Rectangle {
        background: Pal.bar-bg;

        // Left: connection
        HorizontalLayout {
            x: 16px;
            y: (parent.height - self.height) / 2;
            height: 22px;
            spacing: 7px;
            alignment: center;

            Rectangle {
                width: 7px; height: 7px;
                border-radius: 4px;
                y: (parent.height - self.height) / 2;
                background: root.link-state == "LINK" ? Pal.online : Pal.offline;
            }
            Text {
                text: root.link-state;
                color: root.link-state == "LINK" ? Pal.online : Pal.chip-dim;
                font-size: 10px;
                font-family: "Segoe UI";
                font-weight: 700;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
        }

        // Right: REC badge
        rec-badge := Rectangle {
            visible: root.is-recording;
            height: 26px;
            width: ri.preferred-width + 32px;
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            background: Pal.rec-bg;
            border-radius: 5px;
            border-color: Pal.rec;
            border-width: 1px;

            HorizontalLayout {
                width: parent.width; height: parent.height;
                alignment: center; spacing: 6px;
                Rectangle {
                    width: 7px; height: 7px; border-radius: 4px;
                    background: Pal.rec;
                    y: (parent.height - self.height) / 2;
                }
                ri := Text {
                    text: "REC  " + root.rec-elapsed;
                    color: Pal.rec;
                    font-size: 11px; font-family: "Segoe UI"; font-weight: 700;
                    letter-spacing: 0.6px; vertical-alignment: center;
                }
            }
        }
    }
}

// ── Zoom strip — sits directly below TopBar ───────────────────────────────────

component ZoomStrip {
    in-out property <float> zoom-value: 1.0;
    in property <string>    zoom-label: "1.0×";
    callback changed(float);

    height: 44px;

    Rectangle { background: #00000080; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        alignment: center;

        Text {
            text: "1×";
            color: #ffffffa0; font-size: 11px; font-family: "Segoe UI";
            vertical-alignment: center; width: 22px; horizontal-alignment: right;
        }

        ZoomSlider {
            horizontal-stretch: 1;
            value <=> root.zoom-value;
            changed(v) => { root.changed(v); }
        }

        Text {
            text: root.zoom-label;
            color: white; font-size: 13px; font-family: "Segoe UI"; font-weight: 600;
            vertical-alignment: center; width: 40px; horizontal-alignment: center;
        }

        Text {
            text: "6×";
            color: #ffffffa0; font-size: 11px; font-family: "Segoe UI";
            vertical-alignment: center; width: 22px; horizontal-alignment: left;
        }
    }
}

// ── Left exposure column ───────────────────────────────────────────────────────
// Shows shutter / ISO / EV / WB stacked vertically, DJI-style.

component ExposureColumn {
    in property <string> chip1;
    in property <string> chip2;
    in property <string> chip3;
    in property <string> chip4;

    width: 60px;

    Rectangle {
        background: #00000080;

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 4px;
            padding-right: 4px;

            if root.chip1 != "": Text {
                text: root.chip1;
                color: Pal.chip-text; font-size: 11px; font-family: "Segoe UI";
                font-weight: 500; horizontal-alignment: center; wrap: no-wrap;
            }
            if root.chip2 != "": Text {
                text: root.chip2;
                color: Pal.chip-text; font-size: 11px; font-family: "Segoe UI";
                font-weight: 500; horizontal-alignment: center; wrap: no-wrap;
            }
            if root.chip3 != "": Text {
                text: root.chip3;
                color: Pal.chip-text; font-size: 11px; font-family: "Segoe UI";
                font-weight: 500; horizontal-alignment: center; wrap: no-wrap;
            }
            if root.chip4 != "": Text {
                text: root.chip4;
                color: Pal.chip-text; font-size: 11px; font-family: "Segoe UI";
                font-weight: 500; horizontal-alignment: center; wrap: no-wrap;
            }
        }
    }
}

// ── Right status column ────────────────────────────────────────────────────────
// Signal / battery / storage / rec-timer stacked vertically.

component StatusColumn {
    in property <string> link-state;
    in property <string> battery-text;
    in property <string> storage-text;
    in property <bool>   is-recording;
    in property <string> rec-elapsed;

    width: 56px;

    Rectangle {
        background: #00000080;

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 4px;
            padding-right: 4px;

            // Signal dot + label
            Text {
                text: "●";
                color: root.link-state == "LINK" ? Pal.online : Pal.offline;
                font-size: 10px; horizontal-alignment: center;
            }
            Text {
                text: root.battery-text;
                color: Pal.chip-dim; font-size: 10px; font-family: "Segoe UI";
                horizontal-alignment: center;
            }
            Text {
                text: root.storage-text;
                color: Pal.chip-dim; font-size: 10px; font-family: "Segoe UI";
                horizontal-alignment: center;
            }
            if root.is-recording: Text {
                text: root.rec-elapsed;
                color: Pal.rec; font-size: 11px; font-family: "Segoe UI"; font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }
}

// ── Gimbal joystick pad ────────────────────────────────────────────────────────

component GimbalPad {
    callback gimbal-moved(float, float);
    callback gimbal-released();

    width: 88px;
    height: 88px;

    // Outer ring
    Rectangle {
        border-radius: 44px;
        border-width: 1.5px;
        border-color: #ffffff60;
        background: #00000080;
    }

    // D-pad arrows
    Text { text: "▲"; color: #ffffffc0; font-size: 11px; font-family: "Segoe UI";
        x: (parent.width - self.preferred-width) / 2; y: 7px; }
    Text { text: "▼"; color: #ffffffc0; font-size: 11px; font-family: "Segoe UI";
        x: (parent.width - self.preferred-width) / 2;
        y: parent.height - self.preferred-height - 7px; }
    Text { text: "◀"; color: #ffffffc0; font-size: 11px; font-family: "Segoe UI";
        x: 7px; y: (parent.height - self.preferred-height) / 2; }
    Text { text: "▶"; color: #ffffffc0; font-size: 11px; font-family: "Segoe UI";
        x: parent.width - self.preferred-width - 7px;
        y: (parent.height - self.preferred-height) / 2; }

    // Centre dot
    Rectangle {
        width: 14px; height: 14px; border-radius: 7px;
        background: #ffffffd0;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        moved => {
            if self.pressed {
                let dx = ((self.mouse-x - root.width / 2) / (root.width / 2)).clamp(-1, 1);
                let dy = ((self.mouse-y - root.height / 2) / (root.height / 2)).clamp(-1, 1);
                root.gimbal-moved(dx, dy);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.gimbal-released();
            }
        }
    }
}

// ── Record button ─────────────────────────────────────────────────────────────

component RecButton {
    in property <bool> is-recording: false;
    callback tapped();

    width: 72px;
    height: 72px;

    ta := TouchArea { clicked => { root.tapped(); } }

    Rectangle {
        border-radius: 36px;
        border-width: 3px;
        border-color: white;
        background: transparent;
    }
    Rectangle {
        width: 50px; height: 50px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.is-recording ? 6px : 25px;
        background: Pal.rec;
        animate border-radius { duration: 120ms; easing: ease-in-out; }
    }
}

// ── Small action button ────────────────────────────────────────────────────────

component SmallBtn {
    in property <string> label;
    callback tapped();

    width: 52px;
    height: 52px;

    ta := TouchArea { clicked => { root.tapped(); } }

    Rectangle {
        background: #000000b0;
        border-radius: 8px;
        border-width: 1px;
        border-color: Pal.ctrl-border;

        Text {
            text: root.label;
            color: white; font-size: 10px; font-family: "Segoe UI"; font-weight: 600;
            letter-spacing: 0.4px; horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

// ── Phase panel ───────────────────────────────────────────────────────────────

component PhasePanel {
    in property <string> message;
    in property <bool>   failed;

    min-width: 220px;
    height: inner-text.preferred-height + 56px;

    Rectangle {
        background: Pal.panel-bg;
        border-color: Pal.panel-border;
        border-width: 1px;
        border-radius: 14px;

        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
            background: Pal.panel-shine;
        }

        inner-text := Text {
            x: 36px; y: 28px;
            width: parent.width - 72px;
            text: root.message;
            color: root.failed ? Pal.warn : white;
            font-size: 16px; font-family: "Segoe UI"; font-weight: 300;
            letter-spacing: 3.5px; horizontal-alignment: center; wrap: word-wrap;
        }
    }
}

// ── Root overlay ──────────────────────────────────────────────────────────────

export component HudOverlay inherits Window {
    // Exposure chips (shown in left column)
    in property <string> chip1: "";
    in property <string> chip2: "";
    in property <string> chip3: "";
    in property <string> chip4: "";

    // Connection + recording
    in property <string> link-state: "LINKING";
    in property <bool>   is-recording: false;
    in property <string> rec-elapsed: "";

    // Right-column status
    in property <string> battery-text: "";
    in property <string> storage-text: "";

    // Phase overlay
    in property <string> phase-message: "";
    in property <bool>   phase-failed: false;

    // Zoom slider
    in-out property <float> zoom-value: 1.0;
    in property <string>    zoom-label: "1.0×";

    // Callbacks
    callback record-tapped();
    callback still-tapped();
    callback flip-tapped();
    callback recenter-tapped();
    callback zoom-changed(float);
    callback gimbal-moved(float, float);
    callback gimbal-released();

    background: transparent;

    // ── Top bar ───────────────────────────────────────────────────────────
    TopBar {
        x: 0; y: 0; width: parent.width;
        link-state: root.link-state;
        is-recording: root.is-recording;
        rec-elapsed: root.rec-elapsed;
    }

    // ── Zoom strip ────────────────────────────────────────────────────────
    ZoomStrip {
        x: 0; y: 48px; width: parent.width;
        zoom-value <=> root.zoom-value;
        zoom-label: root.zoom-label;
        changed(v) => { root.zoom-changed(v); }
    }

    // ── Left exposure column ──────────────────────────────────────────────
    ExposureColumn {
        x: 0;
        y: 92px;
        height: parent.height - 92px - 80px;
        chip1: root.chip1;
        chip2: root.chip2;
        chip3: root.chip3;
        chip4: root.chip4;
    }

    // ── Right status column ───────────────────────────────────────────────
    StatusColumn {
        x: parent.width - self.width;
        y: 92px;
        height: parent.height - 92px - 80px;
        link-state: root.link-state;
        battery-text: root.battery-text;
        storage-text: root.storage-text;
        is-recording: root.is-recording;
        rec-elapsed: root.rec-elapsed;
    }

    // ── Bottom bar background ─────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 80px;
        background: Pal.bar-bg;
    }

    // ── Gimbal pad (bottom-left) ──────────────────────────────────────────
    GimbalPad {
        x: 20px;
        y: parent.height - 80px + (80px - self.height) / 2;
        gimbal-moved(dx, dy) => { root.gimbal-moved(dx, dy); }
        gimbal-released => { root.gimbal-released(); }
    }

    // ── Record button (bottom-centre) ─────────────────────────────────────
    RecButton {
        x: (parent.width - self.width) / 2;
        y: parent.height - 80px + (80px - self.height) / 2;
        is-recording: root.is-recording;
        tapped => { root.record-tapped(); }
    }

    // ── STILL / FLIP / CTR (bottom-right) ────────────────────────────────
    HorizontalLayout {
        x: parent.width - self.width - 16px;
        y: parent.height - 80px + (80px - self.height) / 2;
        width: 52px + 52px + 52px + 8px + 8px;
        height: 52px;
        spacing: 8px;

        SmallBtn { label: "STILL"; tapped => { root.still-tapped(); } }
        SmallBtn { label: "FLIP";  tapped => { root.flip-tapped(); } }
        SmallBtn { label: "CTR";   tapped => { root.recenter-tapped(); } }
    }

    // ── Phase panel ───────────────────────────────────────────────────────
    if root.phase-message != "": PhasePanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: pm.preferred-width + 80px > 260px
             ? pm.preferred-width + 80px
             : 260px;
        message: root.phase-message;
        failed: root.phase-failed;
    }

    pm := Text {
        visible: false;
        text: root.phase-message;
        font-size: 16px; font-family: "Segoe UI";
        font-weight: 300; letter-spacing: 3.5px;
    }
}
